.PHONY : upet2mnc

# fast build rule for target.
upet2mnc/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/upet2mnc.dir/build.make CMakeFiles/upet2mnc.dir/build
.PHONY : upet2mnc/fast

